      "position": [
        720,
        300
      ],
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "// Requires the Google Sheets lookup node to be enabled and connected.\\nconst existing=$input.all().map(x=>x.json);\\nconst parsed=$('Parse and Normalize Leads').all().map(x=>x.json);\\nconst known=new Set(existing.map(r=>String(r.phone||'').replace(/\\\\s/g,'')));\\nconst today=new Date().toISOString().slice(0,10);\\nconst used=existing.filter(r=>String(r.created_at||'').slice(0,10)===today).length;\\nconst remaining=Math.max(0,50-used);\\nconst batchSeen=new Set();\\nconst fresh=[];\\nfor(const lead of parsed){const phone=String(lead.phone||'');if(!/^\\\\+91[6-9]\\\\d{9}$/.test(phone)||known.has(phone)||batchSeen.has(phone))continue;batchSeen.add(phone);fresh.push({...lead,call_task:'human_call_required',whatsapp_status:'awaiting_approval'});}\\nreturn fresh.slice(0,remaining).map(json=>({json}));"
      },

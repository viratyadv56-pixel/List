      "name": "Extract PDF Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract Indian mobile numbers from PDF text. Review names/number mapping before production.\\nconst text = String($json.text ?? $json.data ?? '');\\nconst matches = [...text.matchAll(/(?:\\\\+?91[\\\\s-]?)?[6-9]\\\\d{9}/g)];\\nconst seen = new Set();\\nconst out=[];\\nfor (const m of matches) {\\n const phone = m[0].replace(/\\\\D/g,'').replace(/^91(?=\\\\d{10}$)/,'');\\n if (phone.length!==10 || seen.has(phone)) continue;\\n seen.add(phone);\\n const idx=m.index ?? 0;\\n const line=text.slice(Math.max(0,text.lastIndexOf('\\\\n',idx-1)+1), text.indexOf('\\\\n',idx)===-1?text.length:text.indexOf('\\\\n',idx));\\n out.push({json:{lead_id:phone,phone:'+91'+phone,source:'pdf_upload',source_line:line.slice(0,240),status:'pending_review',created_at:new Date().toISOString(),consent_status:'unknown'}});\\n}\\nreturn out;"
      },
